# Canonical URL of the deployed site, used for sitemap, hreflang, Open Graph, structured data and llms.txt.
NEXT_PUBLIC_SITE_URL=https://example.com

# Search engine ownership checks (the content="..." value of each meta tag). Leave empty until you have them.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Set to 1 only for a preview build that shows draft articles (marked as drafts, noindex). Never on production.
# SHOW_DRAFTS=1
